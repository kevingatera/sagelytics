# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Client IP for auth rate limits (see docs/auth.md). Set one of these to match your proxy.
# Production refuses to start with neither (unless SKIP_ENV_VALIDATION is set); in development,
# per-IP limits are then skipped and only per-email and endpoint-wide limits apply.
# CLIENT_IP_HEADER names a header your edge always overwrites, e.g. "cf-connecting-ip" behind
# Cloudflare. TRUSTED_PROXY_HOPS is how many proxies append to X-Forwarded-For in front of the app.
CLIENT_IP_HEADER=""
TRUSTED_PROXY_HOPS=""

# Next Auth Google Provider
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/sagelytics"

# Microservices
MICROSERVICE_HOST="localhost"
MICROSERVICE_PORT="3001"

# Email (optional). Password reset and price alerts are skipped when SMTP_HOST or EMAIL_FROM is unset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM="Sagelytics <noreply@example.com>"

# Billing (optional). With STRIPE_SECRET_KEY unset billing is off: everyone gets the free
# allowance and the checkout/portal endpoints answer 503. See docs/billing.md.
APP_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
BILLING_FREE_DISCOVERIES_PER_MONTH="2"
BILLING_PRO_DISCOVERIES_PER_MONTH="50"
BILLING_FREE_MONITORED_PRODUCTS="5"
BILLING_PRO_MONITORED_PRODUCTS="200"
