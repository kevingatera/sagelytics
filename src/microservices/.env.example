NODE_ENV=development
PORT=3000
SPIDER_API_KEY=your_spider_api_key_here 
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VALUESERP_API_KEY=your_valueserp_api_key_here
# Required: PerplexityService reads it at construction (getOrThrow).
PERPLEXITY_API_KEY=your_perplexity_api_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/sagelytics
# Used by docker-compose.yml to set the local Postgres password (keep in sync with DATABASE_URL).
POSTGRES_PASSWORD=password
REDIS_URL=redis://localhost:6379
MICROSERVICE_HOST=localhost
MICROSERVICE_PORT=3001

# Competitor discovery: "legacy" (default) or "two_stage".
# two_stage filters and escalates through OpenAI first, with OpenRouter as fallback.
DISCOVERY_PIPELINE=legacy
DISCOVERY_ESCALATION_THRESHOLD=2
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FILTER_MODEL=openai/gpt-5-mini
OPENROUTER_ESCALATION_MODEL=openai/gpt-5-mini:online
