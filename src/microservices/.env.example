NODE_ENV=development
PORT=3000
SPIDER_API_KEY=your_spider_api_key_here 
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VALUESERP_API_KEY=your_valueserp_api_key_here
# Required: PerplexityService reads it at construction (getOrThrow).
PERPLEXITY_API_KEY=your_perplexity_api_key_here
DATABASE_URL=postgresql://postgres:password@localhost:5432/sagelytics
# Used by docker-compose.yml to set the local Postgres password (keep in sync with DATABASE_URL).
POSTGRES_PASSWORD=password
REDIS_URL=redis://localhost:6379
MICROSERVICE_HOST=localhost
MICROSERVICE_PORT=3001

# Email (optional). Price alert emails are skipped when SMTP_HOST or EMAIL_FROM is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=Sagelytics <noreply@example.com>

# Competitor discovery: "legacy" (default) or "two_stage".
# two_stage filters and escalates through OpenAI first, with OpenRouter as fallback.
DISCOVERY_PIPELINE=legacy
DISCOVERY_ESCALATION_THRESHOLD=2
# Wall-clock budget for one discovery run. Stage slices are carved from it. Keep the client timeout above it.
DISCOVERY_BUDGET_MS=55000
# Parallel competitor enrichment requests (1-6).
COMPETITOR_ENRICHMENT_CONCURRENCY=2
# ValueSERP pay-as-you-go list price per search (https://www.valueserp.com/). Leave empty to report it as unknown.
VALUESERP_COST_PER_QUERY_USD=0.0025
# ValueSERP request timeout in ms (10000-120000).
VALUESERP_TIMEOUT_MS=30000
# Per-call list prices used for discovery cost reporting.
PERPLEXITY_DISCOVERY_COST_USD=0.01
PERPLEXITY_RESEARCH_COST_USD=0.01
# Competitor result cache. Set to false to disable.
ENABLE_COMPETITOR_CACHE=true
# Redis host and port, used when REDIS_URL is unset.
REDIS_HOST=localhost
REDIS_PORT=6379
# Fallback names for the OpenAI settings above. The primary keys take precedence.
OPENAI_FALLBACK_FILTER_MODEL=gpt-5-mini
OPENAI_FALLBACK_FILTER_TIMEOUT_MS=60000
OPENAI_FALLBACK_ESCALATION_MODEL=gpt-5-mini
OPENAI_FALLBACK_ESCALATION_TIMEOUT_MS=180000
OPENAI_FALLBACK_INPUT_COST_PER_MTOKEN=0.25
OPENAI_FALLBACK_OUTPUT_COST_PER_MTOKEN=2
OPENAI_FALLBACK_WEB_COST_PER_1K=10
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FILTER_MODEL=openai/gpt-5-mini
OPENROUTER_ESCALATION_MODEL=openai/gpt-5-mini:online
